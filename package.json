    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "typescript-eslint": "8.72.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "vite": "8.3.5",
    "typescript": "6.0.3",
    "tailwindcss": "4.3.4",
    "@tailwindcss/vite": "4.3.4",
    "vitest": "5.1.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "jsdom": "30.1.3"
  }
